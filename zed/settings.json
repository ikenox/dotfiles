{
  "diff_view_style": "split",
  "icon_theme": "Zed (Default)",
  "cli_default_open_behavior": "new_window",
  "auto_install_extensions": {
    "xml": true,
    "html": true,
    "toml": true,
    "dockerfile": true,
    "terraform": true,
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "terminal_init_command": "claude",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "always",
  },
  "base_keymap": "JetBrains",
  "ui_font_size": 14,
  "ui_font_family": "JetBrains Mono",
  "ui_font_weight": 300,
  "buffer_font_size": 13,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_weight": 300,
  "buffer_font_features": {
    "calt": false,
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "RustRover Dark",
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
      },
      "type": "registry",
    },
  },
}
